{
  "$defs": {
    "MCPEvent": {
      "additionalProperties": false,
      "description": "Tessera event accepted from MCP result metadata.\n\nUnlike the general-purpose :class:`Event`, an MCP event must preserve the\nproducer-assigned identity and occurrence time used by every other delivery\ntransport. Its payload must be a JSON object (or null); the producing service\nremains responsible for validating the domain-specific payload and ensuring\nthat it contains no data unsafe for completion clients.",
      "example": {
        "data": {
          "account_id": "123",
          "email": "account@example.com",
          "name": "Example Account"
        },
        "data_content_type": "application/json",
        "id": "123e4567-e89b-12d3-a456-426614174000",
        "source": "/api/accounts/123",
        "spec_version": "1.0",
        "time": "2024-01-15T10:30:00Z",
        "type": "com.tessera.family.account.created"
      },
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "description": "URI-reference that identifies the context in which an event happened",
          "title": "Source",
          "type": "string"
        },
        "spec_version": {
          "default": "1.0",
          "description": "Version of the CloudEvents specification",
          "title": "Spec Version",
          "type": "string"
        },
        "event_type": {
          "description": "Type of occurrence which has happened",
          "title": "Event Type",
          "type": "string"
        },
        "data_content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "application/json",
          "description": "Content type of data value",
          "title": "Data Content Type"
        },
        "dataschema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URI of the schema that data adheres to",
          "title": "Dataschema"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Describes the subject of the event in the context of the event producer",
          "title": "Subject"
        },
        "time": {
          "format": "date-time",
          "title": "Time",
          "type": "string"
        },
        "event_data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Data"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User ID associated with the event (extension attribute)",
          "title": "User Id"
        },
        "labels": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels associated with the event (extension attribute)",
          "title": "Labels"
        },
        "tags": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "origin:mcp"
              },
              {
                "type": "string",
                "not": {
                  "pattern": "^origin:"
                }
              }
            ]
          },
          "contains": {
            "const": "origin:mcp"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project UUID associated with the event (extension attribute)",
          "title": "Project Id"
        },
        "privy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false,
          "description": "Whether the event is private (extension attribute)",
          "title": "Privy"
        }
      },
      "required": [
        "id",
        "source",
        "event_type",
        "time",
        "tags"
      ],
      "title": "MCPEvent",
      "type": "object"
    },
    "ToolDebug": {
      "additionalProperties": false,
      "description": "Provider-selected diagnostic view of tool arguments and results.\n\nProviders must construct this projection deliberately; it is not permission\nto copy arbitrary tool inputs or outputs. Modela exposes it only through the\nseparately authorized diagnostic channel.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        }
      },
      "title": "ToolDebug",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The Tessera-owned channels recognized in an MCP tool result.\n\n``events`` contains committed domain outcomes intended for reactive clients.\n``debug`` is an optional, provider-selected diagnostic projection. Normal MCP\n``content`` and ``structuredContent`` remain outside this model and continue\nto carry the complete tool response.",
  "properties": {
    "com.tesserahq/events": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MCPEvent"
          },
          "maxItems": 100,
          "title": "Events",
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "com.tesserahq/debug": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolDebug"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Tessera MCP metadata",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tessera.dev/mcp/metadata/v1",
  "propertyNames": {
    "not": {
      "enum": [
        "events",
        "debug"
      ]
    }
  }
}
